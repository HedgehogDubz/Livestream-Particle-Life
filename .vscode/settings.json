{
    "C_Cpp.default.cppStandard": "c++20",
    "code-runner.executorMap": {
        "cpp": "cd $dir && clang++ -std=c++20 -Wall -I/opt/homebrew/include $fileName -o $fileNameWithoutExt -L/opt/homebrew/lib -lraylib -framework Cocoa -framework IOKit -framework OpenGL && $dir$fileNameWithoutExt"
    }
}
